# Pinned versions for the official IRIS macOS tarballs.
# Same Stalwart and Caddy versions as the Linux package (versions.env),
# but the macOS release assets. Hashes verified 2026-11-09 by downloading
# the release tarballs and running sha256sum on them.
STALWART_VERSION=1.0.3
STALWART_ARM64_ASSET=stalwart-aarch64-apple-darwin.tar.gz
STALWART_ARM64_SHA256=4d144d9f8e4be313b310b4db0baa9b184140d6a78b1491dc6e4c86934d0c2436
STALWART_AMD64_ASSET=stalwart-x86_64-apple-darwin.tar.gz
STALWART_AMD64_SHA256=a51ae0ff8ab3447aed899459ddbc8ef43c99bfec89fa42299f25f2d9519b62a4
# Caddy: installed from the distro repo at install time (Debian 12 / Ubuntu 24.04).
# Caddy: official release binary, bundled at build time (no distro repo needed).
CADDY_VERSION=2.11.9
CADDY_ARM64_ASSET=caddy_2.11.9_mac_arm64.tar.gz
CADDY_ARM64_SHA256=d075afc620376679a77b453399bf7ada264cab3280b2833e4ed1372abc0c1c13
CADDY_AMD64_ASSET=caddy_2.11.9_mac_amd64.tar.gz
CADDY_AMD64_SHA256=22af256a2cc45606f6bfa8786cd89130529331319665926f4e972234a658fb30
