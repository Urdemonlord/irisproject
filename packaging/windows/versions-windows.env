# Pinned versions for the official IRIS Windows zip.
# Same Stalwart and Caddy versions as the Linux package (versions.env),
# but the Windows release assets. Hashes verified 2026-11-12 by downloading
# the release zips and running sha256sum on them.
# Note: the Stalwart repo moved from stalwartlabs/mail-server to
# stalwartlabs/stalwart; the URLs below use the new location.
STALWART_VERSION=1.0.3
STALWART_ASSET=stalwart-x86_64-pc-windows-msvc.zip
STALWART_SHA256=b06071564806d6c09a91520fb3ab657bad108cdee571ddaa0f0a57802148e811
STALWART_URL=https://github.com/stalwartlabs/stalwart/releases/download/v1.0.3/stalwart-x86_64-pc-windows-msvc.zip
# Caddy: official release binary, bundled at build time.
CADDY_VERSION=2.11.9
CADDY_ASSET=caddy_2.11.9_windows_amd64.zip
CADDY_SHA256=ad93112d335ee687100c4c9f11bced16ca590377976b7fe7883882b9e797e472
CADDY_URL=https://github.com/caddyserver/caddy/releases/download/v2.11.9/caddy_2.11.9_windows_amd64.zip
# NSSM: service wrapper (Stalwart and iris-api have no native Windows
# service mode; NSSM starts them at boot, stops them cleanly with
# Ctrl+C, and captures their output). nssm-2.24 is the current release.
NSSM_VERSION=2.24
NSSM_ASSET=nssm-2.24.zip
NSSM_SHA256=727d1e42275c605e0f04aba98095c38a8e1e46def453cdffce42869428aa6743
NSSM_URL=https://nssm.cc/release/nssm-2.24.zip
