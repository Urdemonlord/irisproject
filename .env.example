# IRIS Application Configuration
# Copy to .env and fill in your own values. Never commit .env.
IRIS_ENV=development
IRIS_HOST=127.0.0.1
IRIS_PORT=8000

# Mail Server (Stalwart JMAP API — loopback only)
STALWART_API_URL=http://127.0.0.1:8092

# Database
DATABASE_URL=sqlite:iris.db

# Session (generate with: openssl rand -hex 32)
SESSION_SECRET=change-me-to-a-random-secret-of-at-least-32-characters

# Cloudflare Turnstile for the login form (optional). Empty = logins work
# without a challenge. When the secret is set, POST /auth/login requires
# a Turnstile token, verified server-side against Cloudflare's Siteverify
# API before the mail server is contacted. Create the widget in the
# Cloudflare dashboard -> Turnstile -> Add site (hostname: your mail
# domain); the secret key goes here, the public site key below.
#
# BOTH KEYS TOGETHER OR NEITHER: setting the secret without also
# building the web with the site key locks every user out — the form
# renders no widget, so no token is ever sent and each login returns
# 400 turnstile_failed. The installer and the README Deployment
# section forward TURNSTILE_SITE_KEY to the Vite build; a web build
# without VITE_TURNSTILE_SITE_KEY while the secret is set is a broken
# deploy, not a degraded one.
TURNSTILE_SECRET_KEY=
# Public site key for the login widget. Keep it in this file so the
# deployment has one place for both keys; pass it to the web build as
# VITE_TURNSTILE_SITE_KEY (e.g. VITE_TURNSTILE_SITE_KEY=$TURNSTILE_SITE_KEY
# npm --prefix apps/web run build). Empty = no widget.
TURNSTILE_SITE_KEY=
# Frontend hostnames a Turnstile token must have been minted on
# (comma-separated). Set your real mail domain here, e.g.
# TURNSTILE_HOSTNAMES=mail.example.com — the server rejects tokens
# minted on any other hostname, and rejects every login while the
# secret is set but this list is empty. In production, loopback
# hostnames (localhost, 127.0.0.1, ::1) are rejected at startup
# (allowed outside production, for localhost testing). Left empty
# on purpose: a copied .env with real keys but the example hostname
# kept would reject every login.
TURNSTILE_HOSTNAMES=

# Temporary inbox
TEMP_INBOX_DOMAIN=inbox.example.com
TEMP_INBOX_DEFAULT_EXPIRY_HOURS=1
# Catch-all mailbox that receives *@TEMP_INBOX_DOMAIN (messages routed by To: header)
TEMP_INBOX_MAIL_USER=temp@inbox.example.com
TEMP_INBOX_MAIL_PASSWORD=change-me

# Domains IRIS may send to while no outbound relay is configured (comma-separated).
SEND_LOCAL_DOMAINS=example.com
# Allow sending to any domain once the mail server has a working outbound relay.
SEND_EXTERNAL=false

# Fixed sender for scoped transactional auth templates (leave blank to disable).
IRIS_INTEGRATION_EMAIL_FROM=
# Explicit opt-in for the integration email API; default keeps delivery disabled.
IRIS_INTEGRATION_EMAIL_ENABLED=false
# Apps allowed to send transactional email, as JSON. When unset, IRIS uses a
# built-in example registry (alpha/beta/gamma on *.example.com) — replace it
# with your own apps; see apps/api/src/integration_apps.rs for the format.
# Example: IRIS_INTEGRATION_APPS=[{"id":"myapp","host":"app.example.com","templates":[{"id":"auth.verify","subject":"Verify your email","intro":"Use this link to verify your email address.","closing":"If you did not create this account, ignore this message."}]}]
IRIS_INTEGRATION_APPS=

# Optional password-reset webhook for a trusted companion app
# (POST /internal/v1/password-reset-webhook; see README).
# All of these must be set, plus RESEND_API_KEY, for the endpoint to answer.
RESEND_API_KEY=
IRIS_PASSWORD_RESET_SERVICE_TOKEN=replace-with-a-dedicated-random-secret-of-at-least-32-characters
IRIS_PASSWORD_RESET_EMAIL_FROM=admin@example.com
# Store the fixed reset recipient only in the ignored deployment secret file; never in source or request data.
IRIS_PASSWORD_RESET_EMAIL_TO=
IRIS_PASSWORD_RESET_PUBLIC_ORIGIN=reset.example.com
# Deprecated names — still read as fallback when the names above are unset
# or empty. New deployments should use the names above.
# IRIS_TIMELESS_SERVICE_TOKEN=
# IRIS_TIMELESS_EMAIL_FROM=
# IRIS_TIMELESS_EMAIL_TO=
# TIMELESS_PUBLIC_ORIGIN=
# Optional local fake relay; accepted only outside IRIS_ENV=production and only on localhost
IRIS_RESEND_API_URL=

# Separate origin for HTML mail rendering (see docs/separate-mail-origin.md).
# Empty = disabled (srcdoc frame). When set, must be a bare https origin,
# e.g. https://mail-content.example.com — no path. Requires the DNS +
# nginx vhost from the plan; setting this alone changes nothing live.
MAIL_CONTENT_ORIGIN=

# Admin dashboard (read-only, #/admin). Comma-separated emails allowed to
# see it, e.g. IRIS_ADMIN_EMAILS=admin@example.com,ops@example.com.
# Empty = nobody is an admin: every admin request answers 403. The check
# runs server-side on every admin endpoint; the web only hides the link.
IRIS_ADMIN_EMAILS=
