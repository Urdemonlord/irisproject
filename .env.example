# IRIS Application Configuration
IRIS_ENV=development
IRIS_HOST=127.0.0.1
IRIS_PORT=8000

# Mail Server (Stalwart)
STALWART_API_URL=http://127.0.0.1:8092
STALWART_ADMIN_USER=admin
STALWART_ADMIN_PASSWORD=changeme

# Database
DATABASE_URL=sqlite:iris.db

# Session
SESSION_SECRET=change-this-to-a-random-key

# Temporary inbox
TEMP_INBOX_DOMAIN=inbox.meowlabs.id
TEMP_INBOX_DEFAULT_EXPIRY_HOURS=1
# Catch-all mailbox that receives *@TEMP_INBOX_DOMAIN (messages routed by To: header)
TEMP_INBOX_MAIL_USER=temp@inbox.meowlabs.id
TEMP_INBOX_MAIL_PASSWORD=changeme

# Transactional password-reset email for Timeless (required in the deployment environment)
RESEND_API_KEY=
IRIS_TIMELESS_SERVICE_TOKEN=replace-with-a-dedicated-random-secret-at-least-32-characters
IRIS_TIMELESS_EMAIL_FROM=admin@meowlabs.id
# Store the fixed reset recipient only in the ignored deployment secret file; never in source or request data.
IRIS_TIMELESS_EMAIL_TO=
TIMELESS_PUBLIC_ORIGIN=timeless.meowlabs.id
# Optional local fake relay; accepted only outside IRIS_ENV=production and only on localhost
IRIS_RESEND_API_URL=
